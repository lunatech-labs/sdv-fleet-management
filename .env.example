# HawkBit DDI gateway token — shared secret between the in-vehicle ota-agents
# (which present it as `Authorization: GatewayToken <key>` against
# /DEFAULT/controller/v1) and the backend, which provisions this exact value on
# HawkBit's DEFAULT tenant at startup. Both sides read it from here, so neither
# has to wait for the other to come up.
HAWKBIT_GATEWAY_TOKEN=demo-token-change-me

# HawkBit Management API credentials — used by the backend to talk to
# /rest/v1. HawkBit's default admin user is admin:admin.
HAWKBIT_USER=admin
HAWKBIT_PASSWORD=admin

# Simulated OTA install failure rate, between 0.0 and 1.0. The default is 0, so
# a normal run is deterministic and the end-to-end suite is not flaky. Set 0.2
# for a demo that shows the FAILED path.
OTA_FAILURE_RATE=0

# Host port the operator UI is published on.
FRONTEND_PORT=8090

# Base URL the browser uses to reach the backend. Injected into the frontend
# container at runtime, so the same image works in any deployment.
FRONTEND_BACKEND_URL=http://localhost:3000
