#
# VSS overlay for the OTA update flow.
#
# Standard VSS has no signal for the software version a vehicle is currently
# running: Vehicle.VersionVSS describes the version of the VSS model itself, not
# the vehicle's software. The in-vehicle OTA agent writes this signal after a
# successful install so the installed version is observable in-vehicle and is
# reported to the back end through the normal telemetry path.
#
# Applied on top of the VSS standard catalogue together with fms.vspec when
# regenerating spec/overlay/vss.json.

Vehicle:
  type: branch
  description: High-level vehicle data.

Vehicle.SoftwareVersion:
  datatype: string
  type: attribute
  description: Version of the vehicle software currently installed, as reported by the OTA agent after a successful update.
